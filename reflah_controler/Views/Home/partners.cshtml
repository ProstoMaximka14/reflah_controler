@model List<reflah_controler.Models.PartnersModel>
@{
    ViewData["Title"] = "Выбор партнёра для редактирования";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        /* Общие стили для карточек */
        .partner-card {
            transition: transform 0.2s, box-shadow 0.2s;
            height: 100%;
            border-radius: 12px;
            overflow: hidden;
        }
        
        .partner-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        
        /* Стили для изображений (одинаковые с автомобилями) */
        .partner-image {
            height: 200px;
            width: 100%;
            object-fit: cover;
            background-color: #f8f9fa;
            border-radius: 8px;
        }
        
        .placeholder-image {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 200px;
            background-color: #f8f9fa;
            color: #6c757d;
            border-radius: 8px;
        }
        
        /* Стили для сообщений */
        .message-box {
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
            animation: fadeIn 0.5s ease;
        }
        
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .message-success {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }
        
        .message-error {
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
        }
        
        /* Информация о партнёре */
        .partner-info {
            font-size: 0.9rem;
            color: #6c757d;
        }
        
        .partner-info div {
            margin-bottom: 5px;
        }
        
        .partner-info strong {
            color: #495057;
            font-weight: 600;
        }
        
        /* Заголовок карточки */
        .card-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: #1a1a1a;
        }
        
        .card-title .text-muted {
            font-size: 0.9rem;
            font-weight: normal;
        }
        
        /* Кнопки */
        .btn-primary {
            background-color: #0d6efd;
            border: none;
            padding: 8px 16px;
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            background-color: #0b5ed7;
            transform: translateY(-2px);
        }
        
        /* Бейдж для подсчёта */
        .badge.bg-info {
            background-color: #0dcaf0 !important;
            padding: 5px 10px;
            font-size: 0.9rem;
        }
        
        /* Ховер эффект для карточек */
        .partner-card .card-body {
            padding: 1.25rem;
        }
        
        /* Адаптивность */
        @@media (max-width: 768px) {
            .partner-image, .placeholder-image {
                height: 150px;
            }
            
            .card-title {
                font-size: 1rem;
            }
        }
        
        /* Стили для фото-превью */
        .photo-preview {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 8px;
            background-color: #f8f9fa;
        }
        
        /* Анимация для сообщений */
        .message-box {
            animation: slideDown 0.5s ease;
        }
        
        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* Стили для иконок */
        .bi {
            margin-right: 5px;
        }
        
        /* Контейнер для фото с фоном */
        .photo-container {
            background-color: #f8f9fa;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 200px;
        }
        
        /* Разделитель */
        .divider {
            border-top: 1px solid #dee2e6;
            margin: 15px 0;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <!-- Сообщения -->
        @if (TempData["Message"] != null)
        {
            <div class="message-box message-success">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Message"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="message-box message-error">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                @TempData["Error"]
            </div>
        }

        <h1 class="mb-4">
            <i class="bi bi-people-fill text-primary"></i>
            Выбор партнёра для редактирования
        </h1>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
            <div class="mb-3 mb-md-0">
                <span class="text-muted">Всего партнёров:</span>
                <span class="badge bg-info ms-2">@Model.Count</span>
            </div>

            <a href="@Url.Action("CreatePartner", new { id = 0 })" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Добавить партнёра
            </a>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var partner in Model)
                {
                    <div class="col">
                        <div class="card partner-card h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="bi bi-building"></i>
                                    @partner.name
                                    @if (!string.IsNullOrEmpty(partner.city))
                                    {
                                        <span class="text-muted">
                                            <i class="bi bi-geo-alt"></i> (@partner.city)
                                        </span>
                                    }
                                </h5>
                                
                                <div class="mb-3">
                                    @if (!string.IsNullOrEmpty(partner.photo))
                                    {
                                        <img src="/shared-fotos/partners/@partner.photo" 
                                             class="partner-image" 
                                             alt="Фото партнера @partner.name"
                                             onerror="this.onerror=null; this.src='/images/default-partner.jpg'">
                                    }
                                    else
                                    {
                                        <div class="placeholder-image">
                                            <i class="bi bi-building fs-1"></i>
                                            <span class="ms-2">Нет фото</span>
                                        </div>
                                    }
                                </div>
                                
                                <div class="partner-info mb-3">
                                    <div>
                                        <i class="bi bi-telephone-fill"></i>
                                        <strong>Телефон:</strong> @partner.phone
                                    </div>
                                    @if (!string.IsNullOrEmpty(partner.vk))
                                    {
                                        <div>
                                            <i class="bi bi-vk"></i>
                                            <strong>VK:</strong> 
                                            <a href="@partner.vk" target="_blank" class="text-decoration-none">Профиль</a>
                                        </div>
                                    }
                                    <div class="divider"></div>
                                    <div>
                                        <i class="bi bi-hash"></i>
                                        <strong>ID:</strong> #@partner.Id
                                    </div>
                                </div>

                                <div class="d-grid gap-2">
                                    <a href="@Url.Action("EditPartner", new { id = partner.Id })" class="btn btn-primary">
                                        <i class="bi bi-pencil-square"></i>
                                        Редактировать партнёра
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center">
                <i class="bi bi-exclamation-triangle fs-1 d-block mb-3"></i>
                <h5>Нет партнёров</h5>
                <p class="mb-3">Добавьте первого партнёра для управления.</p>
                <a href="@Url.Action("CreatePartner", new { id = 0 })" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    Добавить партнёра
                </a>
            </div>
        }
    </div>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Автоматически скрываем сообщения через 5 секунд
        document.addEventListener('DOMContentLoaded', function() {
            const messages = document.querySelectorAll('.message-box');
            messages.forEach(message => {
                setTimeout(() => {
                    message.style.opacity = '0';
                    message.style.transition = 'opacity 0.5s ease';
                    setTimeout(() => {
                        if (message.parentNode) {
                            message.parentNode.removeChild(message);
                        }
                    }, 500);
                }, 5000);
            });
        });
    </script>
</body>
</html>