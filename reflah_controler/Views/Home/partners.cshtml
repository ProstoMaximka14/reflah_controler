@model List<reflah_controler.Models.PartnersModel>
@{
    ViewData["Title"] = "Управление партнерами";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        .partner-input {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            box-sizing: border-box;
            font-size: 14px;
        }

            .partner-input:focus {
                border-color: #86b7fe;
                outline: 0;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            }

        .btn-action {
            padding: 6px 12px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin: 2px;
        }

        .btn-save {
            background-color: #198754;
            color: white;
        }

            .btn-save:hover {
                background-color: #157347;
            }

        .btn-delete {
            background-color: #dc3545;
            color: white;
        }

            .btn-delete:hover {
                background-color: #bb2d3b;
            }

        .btn-cancel {
            background-color: #6c757d;
            color: white;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 14px;
            margin: 2px;
        }

            .btn-cancel:hover {
                background-color: #5c636a;
                color: white;
                text-decoration: none;
            }

        .message-box {
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        .message-success {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }

        .message-error {
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
        }

        .photo-preview {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 4px;
            border: 1px solid #dee2e6;
        }

        .table th {
            vertical-align: middle;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        .url-cell {
            max-width: 200px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <!-- Сообщения -->
        @if (TempData["Message"] != null)
        {
            <div class="message-box message-success">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Message"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="message-box message-error">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                @TempData["Error"]
            </div>
        }

        <h1 class="mb-4">
            <i class="bi bi-handshake text-primary"></i>
            Управление партнерами
        </h1>

        @if (Model != null && Model.Count > 0)
        {
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
                <div class="mb-3 mb-md-0">
                    <span class="text-muted">Всего партнеров:</span>
                    <span class="badge bg-info ms-2">@Model.Count</span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th style="width: 120px;">Фото</th>
                            <th>Имя</th>
                            <th>Телефон</th>
                            <th>ВКонтакте</th>
                            <th>Сайт</th>
                            <th>Город</th>
                            <th>Улица</th>
                            <th>Дом</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var partner = Model[i];

                            <form method="post" action="/Home/UpdatePartner" enctype="multipart/form-data">
                            <tr>
                                <td class="fw-bold text-center">@(i + 1)</td>

                                <td>
                                    <div class="d-flex flex-column align-items-center">
                                        @if (!string.IsNullOrEmpty(partner.photo))
                                        {
                                            <img src="/shared-fotos/partners/@partner.photo" 
                                                    class="photo-preview mb-2" 
                                                    alt="Фото партнера"
                                                    onerror="this.src='/images/default-partner.jpg'">
                                        }
                                        else
                                        {
                                            <div class="photo-preview mb-2 bg-light d-flex align-items-center justify-content-center">
                                                <i class="bi bi-image text-muted"></i>
                                            </div>
                                        }
                                        <input type="file"
                                               name="photoFile"
                                               class="form-control form-control-sm"
                                               accept="image/*"
                                               onchange="previewImage(this, 'preview-@partner.Id')">
                                        <input type="hidden" name="photo" value="@partner.photo">
                                    </div>
                                </td>

                                <td>
                                    <input type="text"
                                           name="name"
                                           value="@partner.name"
                                           required
                                           class="partner-input"
                                           placeholder="Имя партнера">
                                </td>

                                <td>
                                    <input type="tel"
                                           name="phone"
                                           value="@partner.phone"
                                           class="partner-input"
                                           placeholder="+7 (999) 123-45-67">
                                </td>

                                <td>
                                    <input type="url"
                                           name="vk"
                                           value="@partner.vk"
                                           class="partner-input"
                                           placeholder="https://vk.com/username">
                                </td>

                                <td>
                                    <input type="url"
                                           name="website"
                                           value="@partner.website"
                                           class="partner-input"
                                           placeholder="https://example.com">
                                </td>
                                <td>
                                    <input type="text"
                                           name="city"
                                           value="@partner.city"
                                           required
                                           class="partner-input"
                                           placeholder="Город">
                                </td>
                                <td>
                                    <input type="text"
                                           name="street"
                                           value="@partner.street"
                                           required
                                           class="partner-input"
                                           placeholder="Улица">
                                </td>
                                <td>
                                    <input type="text"
                                           name="house"
                                           value="@partner.house"
                                           required
                                           class="partner-input"
                                           placeholder="номер дома">
                                </td>

                                <td class="text-nowrap">
                                    <input type="hidden" name="id" value="@partner.Id">

                                    <div class="d-flex flex-column flex-sm-row gap-2">
                                        <!-- Кнопка сохранения -->
                                        <button type="submit" class="btn-action btn-save">
                                            <i class="bi bi-check-circle"></i>
                                            <span class="d-none d-sm-inline">Сохранить</span>
                                        </button>

                                        <!-- Кнопка удаления -->
                                        <button type="submit"
                                                formaction="/Home/DeletePartner"
                                                class="btn-action btn-delete"
                                                onclick="return confirm('Вы уверены, что хотите удалить партнера @partner.name?')">
                                            <i class="bi bi-trash"></i>
                                            <span class="d-none d-sm-inline">Удалить</span>
                                        </button>

                                        <!-- Кнопка отмены -->
                                        <a href="@Url.Action("Partners", "Home")" class="btn-cancel">
                                            <i class="bi bi-x-circle"></i>
                                            <span class="d-none d-sm-inline">Отмена</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            </form>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Форма добавления нового партнера -->
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-person-plus text-success"></i>
                    Добавить нового партнера
                </h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Home/AddPartner" enctype="multipart/form-data">
                    <div class="row g-3">
                        <div class="col-12 col-md-2">
                            <label class="form-label">Фото</label>
                            <div class="d-flex flex-column align-items-center">
                                <div class="photo-preview mb-2 bg-light d-flex align-items-center justify-content-center" id="newPhotoPreview">
                                    <i class="bi bi-image text-muted"></i>
                                </div>
                                <input type="file"
                                       name="photoFile"
                                       class="form-control"
                                       accept="image/*"
                                       onchange="previewImage(this, 'newPhotoPreview')">
                            </div>
                        </div>

                        <div class="col-12 col-md-2">
                            <label for="newName" class="form-label">Имя</label>
                            <input type="text"
                                   class="form-control"
                                   id="newName"
                                   name="name"
                                   placeholder="Имя партнера"
                                   required>
                        </div>

                        <div class="col-12 col-md-2">
                            <label for="newPhone" class="form-label">Телефон</label>
                            <input type="tel"
                                   class="form-control"
                                   id="newPhone"
                                   name="phone"
                                   placeholder="+7 (999) 123-45-67">
                        </div>

                        <div class="col-12 col-md-3">
                            <label for="newVk" class="form-label">ВКонтакте</label>
                            <input type="url"
                                   class="form-control"
                                   id="newVk"
                                   name="vk"
                                   placeholder="https://vk.com/username">
                        </div>

                        <div class="col-12 col-md-3">
                            <label for="newWebsite" class="form-label">Сайт</label>
                            <input type="url"
                                   class="form-control"
                                   id="newWebsite"
                                   name="website"
                                   placeholder="https://example.com">
                        </div>
                        <div class="col-12 col-md-2">
                            <label for="newCity" class="form-label">Город</label>
                            <input type="text"
                                   class="form-control"
                                   id="newCity"
                                   name="city"
                                   placeholder="Город"
                                   required>
                        </div>
                        <div class="col-12 col-md-2">
                            <label for="newStreet" class="form-label">улица</label>
                            <input type="text"
                                   class="form-control"
                                   id="newStreet"
                                   name="street"
                                   placeholder="Улица"
                                   required>
                        </div>
                        <div class="col-12 col-md-2">
                            <label for="newHouse" class="form-label">Номер дома</label>
                            <input type="text"
                                   class="form-control"
                                   id="newHouse"
                                   name="house"
                                   placeholder="Номер дома"
                                   required>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-plus-circle"></i>
                                Добавить партнера
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Функция для предпросмотра изображения
        function previewImage(input, previewId) {
            const preview = document.getElementById(previewId);
            const file = input.files[0];

            if (file) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    if (preview.tagName === 'IMG') {
                        preview.src = e.target.result;
                    } else {
                        preview.innerHTML = `<img src="${e.target.result}" class="photo-preview" alt="Предпросмотр">`;
                    }
                }

                reader.readAsDataURL(file);
            } else {
                if (preview.tagName === 'IMG') {
                    preview.src = '';
                } else {
                    preview.innerHTML = '<i class="bi bi-image text-muted"></i>';
                }
            }
        }

        // Автоматически скрываем сообщения через 5 секунд
        document.addEventListener('DOMContentLoaded', function () {
            const messages = document.querySelectorAll('.message-box');
            messages.forEach(message => {
                setTimeout(() => {
                    message.style.opacity = '0';
                    message.style.transition = 'opacity 0.5s ease';
                    setTimeout(() => {
                        if (message.parentNode) {
                            message.parentNode.removeChild(message);
                        }
                    }, 500);
                }, 5000);
            });

            // Валидация URL полей
            const urlInputs = document.querySelectorAll('input[type="url"]');
            urlInputs.forEach(input => {
                input.addEventListener('blur', function () {
                    if (this.value && !this.value.startsWith('http://') && !this.value.startsWith('https://')) {
                        this.value = 'https://' + this.value;
                    }
                });
            });
        });
    </script>
</body>
</html>
