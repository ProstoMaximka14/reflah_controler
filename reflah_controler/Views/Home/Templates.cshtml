    function saveEditItem(event) {
        event.preventDefault();
        var form = document.getElementById('editForm');
        var formData = new FormData(form);

        var returnTab = getActiveTab();
        formData.append('returnTab', returnTab);

        // ===== ДОБАВЛЯЕМ ЯВНУЮ ПЕРЕДАЧУ unselectedPriceMode =====
        var unselectedModeSelect = form.querySelector('select[name="unselectedPriceMode"]');
        if (unselectedModeSelect) {
            formData.set('unselectedPriceMode', unselectedModeSelect.value);
        }

        var btn = form.querySelector('button[type="submit"]');
        var originalText = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Сохранение...';
        btn.disabled = true;

        fetch('/Home/UpdateItem', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showTempMessage('Запись сохранена ✓', 'success');
                closeEditModal();
                var activeTab = document.querySelector('.nav-link.active')?.getAttribute('data-bs-target')?.replace('#tab-', '') || 'about';
                window.location.href = '/Home/Templates?activeTab=' + activeTab;
            } else {
                showTempMessage('Ошибка: ' + (data.message || 'неизвестная'), 'error');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        })
        .catch(error => {
            console.error('Ошибка:', error);
            showTempMessage('Ошибка при сохранении', 'error');
            btn.innerHTML = originalText;
            btn.disabled = false;
        });
    }

    function getTypeLabel(type) {
        switch (type) {
            case 'about': return 'Описания';
            case 'result': return 'Результаты';
            case 'engine': return 'Блоки управления';
            case 'price': return 'Цены опций';
            case 'grafic': return 'Графики';
            case 'additional': return 'Доп. цены';
            default: return type;
        }
    }

    function closeEditModal() {
        document.getElementById('editModal').classList.remove('show');
        currentEditType = null;
        currentEditId = null;
    }

    // Закрытие по клику вне модального окна
    document.addEventListener('click', function(e) {
        var modal = document.getElementById('editModal');
        if (modal.classList.contains('show') && e.target === modal) {
            closeEditModal();
        }
    });

    // ==========================================
    // УДАЛЕНИЕ ЗАПИСИ ИЗ СПИСКА
    // ==========================================
    function deleteItem(type, id) {
        if (!confirm(`Удалить запись #${id} из базы данных? Это действие нельзя отменить!`)) {
            return;
        }

        var returnTab = getActiveTab();

        fetch('/Home/DeleteItemById', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                type: type,
                id: id,
                returnTab: returnTab
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showTempMessage('Запись #' + id + ' удалена ✓', 'success');
                var activeTab = data.returnTab || returnTab;
                window.location.href = '/Home/Templates?activeTab=' + activeTab;
            } else {
                showTempMessage('Ошибка: ' + (data.message || 'неизвестная'), 'error');
            }
        })
        .catch(error => {
            console.error('Ошибка:', error);
            showTempMessage('Ошибка при удалении', 'error');
        });
    }

    // ==========================================
    // УДАЛЕНИЕ НЕИСПОЛЬЗУЕМЫХ ЗАПИСЕЙ
    // ==========================================
    function deleteUnusedItems(type) {
        if (!confirm(`Удалить все неиспользуемые записи типа "${getTypeLabel(type)}"?\n\nЗаписи, которые не используются ни в одной машине и ни в одном шаблоне, будут удалены без возможности восстановления!`)) {
            return;
        }

        var returnTab = getActiveTab();
        showTempMessage('Поиск неиспользуемых записей...', 'info');

        fetch('/Home/DeleteUnusedItems', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                type: type,
                returnTab: returnTab
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showTempMessage(`Удалено ${data.deletedCount || 0} неиспользуемых записей ✓`, 'success');
                var activeTab = data.returnTab || returnTab;
                window.location.href = '/Home/Templates?activeTab=' + activeTab;
            } else {
                showTempMessage('Ошибка: ' + (data.message || 'неизвестная'), 'error');
            }
        })
        .catch(error => {
            console.error('Ошибка:', error);
            showTempMessage('Ошибка при удалении', 'error');
        });
    }

    // ==========================================
    // ПЕРЕМЕЩЕНИЕ ЗАПИСИ В ШАБЛОНЕ (ЧЕРЕЗ КНОПКИ)
    // ==========================================
    function moveTemplateItem(type, templateId, itemId, direction) {
        showTempMessage('Перемещение...', 'info');

        var returnTab = getActiveTab();

        fetch('/Home/TemplateMoveItem', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                type: type,
                templateId: templateId,
                itemId: itemId,
                direction: direction,
                returnTab: returnTab
            })
        })
        .then(function(response) {
            if (!response.ok) {
                throw new Error('Ошибка сервера: ' + response.status);
            }
            return response.json();
        })
        .then(function(data) {
            if (data.success) {
                showTempMessage('Запись перемещена ✓', 'success');
                var activeTab = data.returnTab || returnTab;
                window.location.href = '/Home/Templates?activeTab=' + activeTab;
            } else {
                showTempMessage('Ошибка: ' + (data.message || 'неизвестная'), 'error');
            }
        })
        .catch(function(error) {
            console.error('Ошибка:', error);
            showTempMessage('Ошибка: ' + error.message, 'error');
        });
    }

