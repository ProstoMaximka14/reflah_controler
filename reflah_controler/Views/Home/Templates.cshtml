    // ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ РАБОТЫ С ID
    // ==========================================

    // Очистка дубликатов в строке ID
    function getUniqueIdsString(idsString) {
        if (!idsString) return '';
        var ids = idsString.split(',');
        var uniqueIds = [];
        var seen = new Set();
        for (var i = 0; i < ids.length; i++) {
            var id = ids[i].trim();
            if (id && !seen.has(id)) {
                seen.add(id);
                uniqueIds.push(id);
            }
        }
        return uniqueIds.join(',');
    }

    // Получение массива ID из скрытого поля
    function getIdsFromHidden(hiddenElement) {
        if (!hiddenElement || !hiddenElement.value) return [];
        return hiddenElement.value.split(',').filter(function(id) { return id.trim() !== ''; });
    }

    // Установка ID в скрытое поле (с удалением дубликатов)
    function setIdsToHidden(hiddenElement, ids) {
        if (!hiddenElement) return;
        var uniqueIds = [];
        var seen = new Set();
        for (var i = 0; i < ids.length; i++) {
            var id = ids[i].toString().trim();
            if (id && !seen.has(id)) {
                seen.add(id);
                uniqueIds.push(id);
            }
        }
        hiddenElement.value = uniqueIds.join(',');
    }

