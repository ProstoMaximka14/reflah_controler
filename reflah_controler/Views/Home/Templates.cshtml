                                </div>
                            </div>

                            <!-- ===== ФОРМА ДОБАВЛЕНИЯ ЗАПИСИ ===== -->
                            <div id="addItemForm-grafic-@template.Id" class="card-body d-none" style="background: #f8f9fa; border-bottom: 1px solid #dee2e6;">
                                <h6 class="mb-3"><i class="bi bi-plus-circle"></i> Добавить запись в шаблон</h6>
                                <form method="post" action="@Url.Action("AddItemToTemplate", "Home")">
                                    <input type="hidden" name="templateId" value="@template.Id" />
                                    <input type="hidden" name="type" value="grafic" />
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label small">Выберите запись</label>
                                            <select class="form-select form-select-sm" name="existingItemId" id="unusedItems-grafic-@template.Id">
                                                <option value="">-- Выберите запись --</option>
                                            </select>
                                            <div class="form-text text-muted small">Будет создана копия выбранной записи</div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small">ID существующего шаблона</label>
                                            <select class="form-select form-select-sm" name="existingTemplateId">
                                                <option value="">-- Выберите шаблон --</option>
                                                @foreach (var t in Model.GraficTemplates)
                                                {
                                                    if (t.Id != template.Id)
                                                    {
                                                        <option value="@t.Id">@t.Name (ID: @t.Id, @t.Items.Count записей)</option>
                                                    }
                                                }
                                            </select>
                                            <div class="form-text text-muted small">Шаблон будет добавлен как вложенный</div>
                                        </div>
                                        <div class="col-md-12">
                                            <hr class="my-2" />
                                            <span class="text-success"><i class="bi bi-pencil"></i> Или создайте новую запись:</span>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Название RU</label>
                                            <input type="text" class="form-control form-control-sm" name="graficName" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Название EN</label>
                                            <input type="text" class="form-control form-control-sm" name="graficNameEng" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Название DE</label>
                                            <input type="text" class="form-control form-control-sm" name="graficNameGer" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Описание RU</label>
                                            <textarea class="form-control form-control-sm" name="graficDescriptionRu" rows="2"></textarea>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Описание EN</label>
                                            <textarea class="form-control form-control-sm" name="graficDescriptionEng" rows="2"></textarea>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Описание DE</label>
                                            <textarea class="form-control form-control-sm" name="graficDescriptionGer" rows="2"></textarea>
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label small">Изображение</label>
                                            <input type="file" class="form-control form-control-sm" name="graficImageFile" accept="image/*" />
                                        </div>
                                        <div class="col-md-12">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check-lg"></i> Добавить
                                            </button>
                                            <button type="button" class="btn btn-sm btn-secondary" onclick="hideAddItemForm('grafic', @template.Id)">
                                                Отмена
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>

                            <!-- ===== КОНТЕНТ ШАБЛОНА ===== -->
                            <div class="card-body template-content">
                                <div class="items-list" id="items-list-grafic-@template.Id">
                                    @if (template.Items.Any())
                                    {
                                        foreach (var item in template.Items)
                                        {
                                            var itemIndex = template.Items.IndexOf(item);
                                            var isFirst = itemIndex == 0;
                                            var isLast = itemIndex == template.Items.Count - 1;

                                            <div class="list-item" data-item-id="@item.Id">
                                                <div class="item-content">
                                                    <span class="badge bg-secondary">#@item.Id</span>
                                                    <span class="item-preview-text">@item.DisplayText</span>
                                                    @if (!string.IsNullOrEmpty(item.GraficImage))
                                                    {
                                                        <img src="/shared-fotos/grafics/@item.GraficImage" style="max-height:30px; border-radius:4px;" />
                                                    }
                                                </div>
                                                <div class="item-actions">
                                                    @if (!isFirst)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-secondary move-btn" onclick="moveTemplateItem('grafic', @template.Id, @item.Id, 'up')" title="Вверх">
                                                            <i class="bi bi-chevron-up"></i>
                                                        </button>
                                                    }
                                                    @if (!isLast)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-secondary move-btn" onclick="moveTemplateItem('grafic', @template.Id, @item.Id, 'down')" title="Вниз">
                                                            <i class="bi bi-chevron-down"></i>
                                                        </button>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="showEditForm('grafic', @template.Id, @item.Id)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <form method="post" action="@Url.Action("RemoveItemFromTemplate", "Home")" style="display:inline;" onsubmit="return confirm('Отвязать запись #@item.Id от шаблона?')">
                                                        <input type="hidden" name="templateId" value="@template.Id" />
                                                        <input type="hidden" name="itemId" value="@item.Id" />
                                                        <input type="hidden" name="type" value="grafic" />
                                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                                            <i class="bi bi-link-45deg"></i>
                                                        </button>
                                                    </form>
                                                    <form method="post" action="@Url.Action("DeleteItemFromTemplate", "Home")" style="display:inline;" onsubmit="return confirm('Удалить запись #@item.Id из базы данных? Это действие нельзя отменить!')">
                                                        <input type="hidden" name="templateId" value="@template.Id" />
                                                        <input type="hidden" name="itemId" value="@item.Id" />
                                                        <input type="hidden" name="type" value="grafic" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>

                                            <!-- ===== ФОРМА РЕДАКТИРОВАНИЯ ДЛЯ GRAFIC ===== -->
                                            <div id="edit-grafic-@template.Id-@item.Id" class="d-none" style="padding: 8px 12px 8px 40px; background: #f8f9fa; border-radius: 6px; margin-bottom: 4px;">
                                                <div class="edit-form">
                                                    <form method="post" action="@Url.Action("UpdateTemplateItem", "Home")">
                                                        <input type="hidden" name="templateId" value="@template.Id" />
                                                        <input type="hidden" name="itemId" value="@item.Id" />
                                                        <input type="hidden" name="type" value="grafic" />
                                                        <div class="row g-2">
                                                            <div class="col-md-4">
                                                                <label class="form-label small">Название RU</label>
                                                                <input type="text" class="form-control form-control-sm" name="name" value="@item.GraficName" />
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label small">Название EN</label>
                                                                <input type="text" class="form-control form-control-sm" name="nameEng" value="@item.GraficNameEng" />
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label small">Название DE</label>
                                                                <input type="text" class="form-control form-control-sm" name="nameGer" value="@item.GraficNameGer" />
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label small">Описание RU</label>
                                                                <textarea class="form-control form-control-sm" name="descriptionRu" rows="2">@item.GraficDescriptionRu</textarea>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label small">Описание EN</label>
                                                                <textarea class="form-control form-control-sm" name="descriptionEng" rows="2">@item.GraficDescriptionEng</textarea>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label small">Описание DE</label>
                                                                <textarea class="form-control form-control-sm" name="descriptionGer" rows="2">@item.GraficDescriptionGer</textarea>
                                                            </div>
                                                            <div class="col-md-12">
                                                                <label class="form-label small">Изображение</label>
                                                                @if (!string.IsNullOrEmpty(item.GraficImage))
                                                                {
                                                                    <div class="mb-1">
                                                                        <img src="/shared-fotos/grafics/@item.GraficImage" style="max-height:60px; border-radius:4px;" />
                                                                        <div class="text-muted small">@item.GraficImage</div>
                                                                    </div>
                                                                }
                                                                <input type="file" class="form-control form-control-sm" name="imageFile" accept="image/*" />
                                                                <div class="form-text text-muted small">Оставьте пустым, чтобы не менять изображение</div>
                                                                <input type="hidden" name="image" value="@item.GraficImage" />
                                                            </div>
                                                        </div>
                                                        <div class="mt-2 d-flex gap-2">
                                                            <button type="submit" class="btn btn-sm btn-primary">
                                                                <i class="bi bi-check-lg"></i> Сохранить
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-secondary" onclick="hideEditForm('grafic', @template.Id, @item.Id)">
                                                                Отмена
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-muted text-center py-2">Нет записей в шаблоне</div>
                                    }
                                </div>
                            </div>

                            <!-- ===== ФОРМА РЕДАКТИРОВАНИЯ НАЗВАНИЯ ===== -->
                            <div id="rename-grafic-@template.Id" class="edit-form mt-2 d-none">
                                <form method="post" action="@Url.Action("UpdateTemplateName", "Home")">
                                    <input type="hidden" name="id" value="@template.Id" />
                                    <input type="hidden" name="type" value="grafic" />
                                    <div class="row g-2">
                                        <div class="col">
                                            <input type="text" class="form-control form-control-sm" name="name" value="@template.Name" required />
                                        </div>
                                        <div class="col-auto">
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-secondary" onclick="hideRenameForm('grafic', @template.Id)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted text-center py-4">
                        <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                        Нет шаблонов графиков
                    </div>
                }
            </div>

            <!-- ===== ФОРМА СОЗДАНИЯ ШАБЛОНА GRAFIC ===== -->
            <div class="card mt-3 d-none" id="createForm_grafic">
                <div class="card-header">
                    <h5 class="mb-0">Создать шаблон Графиков</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="@Url.Action("CreateGraficTemplateWithItems", "Home")" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Название шаблона *</label>
                            <input type="text" class="form-control" name="templateName" placeholder="Введите название шаблона" required />
                        </div>
                        <hr />
                        <h6 class="mb-3"><i class="bi bi-plus-circle"></i> Добавьте записи в шаблон</h6>

                        <div class="row g-2 mt-3">
                            <div class="col-md-12">
                                <h6 class="text-primary"><i class="bi bi-collection"></i> Добавить существующий шаблон</h6>
                                <div class="row g-2">
                                    <div class="col-md-8">
                                        <select class="form-select form-select-sm" id="existingTemplateSelect_grafic">
                                            <option value="">-- Выберите шаблон --</option>
                                            @foreach (var t in Model.GraficTemplates ?? new List<reflah_controler.Models.TemplateWithItems>())
                                            {
                                                <option value="@t.Id">@t.Name (ID: @t.Id, @t.Items.Count записей)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="button" class="btn btn-sm btn-outline-primary w-100" onclick="addExistingTemplateToForm('grafic', 'graficItemsContainer')">
                                            <i class="bi bi-plus-lg"></i> Добавить шаблон
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="graficItemsContainer">
                            <!-- Карточки записей будут добавляться через JavaScript -->
                        </div>

                        <button type="button" class="btn btn-outline-primary btn-sm mb-3" onclick="addItem('grafic', 'graficItemsContainer', 'graficItemTemplate')">
                            <i class="bi bi-plus-lg"></i> Добавить ещё запись
                        </button>

                        <div class="d-flex gap-2 mt-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg"></i> Создать шаблон
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="hideCreateForm('grafic')">Отмена</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="text-center mt-3">
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="showCreateForm('grafic')">
                    <i class="bi bi-plus-circle"></i> Показать форму создания
                </button>
            </div>
        </div>

    </div>
</div>

