    // ==========================================
    // ПОДДЕРЖКА ENTER ДЛЯ ПОЛЯ ВВОДА ID
    // ==========================================

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('input[id^="priceIdInput_"]').forEach(function(input) {
            input.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    var templateId = this.id.replace('priceIdInput_', '');
                    addPriceById(templateId);
                }
            });
        });
        
        document.querySelectorAll('input[id^="editPriceIdInput_"]').forEach(function(input) {
            input.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    var ids = this.id.replace('editPriceIdInput_', '').split('_');
                    var templateId = ids[0];
                    var itemId = ids[1];
                    editAddPriceById(templateId, itemId);
                }
            });
        });
    });

    // Синхронизация unselectedPriceMode для форм редактирования в шаблоне
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            document.querySelectorAll('form[action*="UpdateTemplateItem"]').forEach(function(form) {
                var select = form.querySelector('select[name="unselectedPriceMode"]');
                if (!select) return;
                
                var hidden = form.querySelector('input[name="unselectedPriceModeHidden"]');
                if (!hidden) {
                    hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'unselectedPriceModeHidden';
                    hidden.value = select.value;
                    form.appendChild(hidden);
                }
                
                hidden.value = select.value;
                
                select.addEventListener('change', function() {
                    hidden.value = this.value;
                    console.log('✅ unselectedPriceMode changed to:', this.value);
                });
            });
        }, 1000);
    });

    // ==========================================
        // ИНИЦИАЛИЗАЦИЯ DRAG-AND-DROP ДЛЯ ШАБЛОНОВ (КАРТОЧЕК)
        // ==========================================
        function initSortableForTemplates(container) {
            if (!container || container.dataset.sortableInitialized) return;
            container.dataset.sortableInitialized = 'true';

            var type = container.dataset.type || 'about';

            new Sortable(container, {
                animation: 150,
                handle: '.card-header',
                ghostClass: 'sortable-ghost',
                dragClass: 'sortable-drag',
                onEnd: function(evt) {
                    var items = container.querySelectorAll('.template-section');
                    var orderedIds = [];
                    
                    items.forEach(function(item) {
                        var id = item.dataset.templateId;
                        if (id) orderedIds.push(parseInt(id));
                    });

                    if (orderedIds.length < 2) return;

                    fetch('/Home/ReorderTemplates', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            type: type,
                            templateIds: orderedIds
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showTempMessage('Порядок шаблонов сохранён ✓', 'success');
                        } else {
                            showTempMessage('Ошибка: ' + (data.message || 'неизвестная'), 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Ошибка:', error);
                        showTempMessage('Ошибка при сохранении порядка шаблонов', 'error');
                    });
                }
            });
        }

    // ==========================================
    // ПОЛНАЯ ИНИЦИАЛИЗАЦИЯ ПРИ ЗАГРУЗКЕ
    // ==========================================

    document.addEventListener('DOMContentLoaded', function() {
        console.log('=== Инициализация Drag-and-Drop ===');
        
        // Автоматическое скрытие alert-сообщений
        var alerts = document.querySelectorAll('.alert');
        alerts.forEach(function(alert) {
            setTimeout(function() {
                alert.style.opacity = '0';
                alert.style.transition = 'opacity 0.5s ease';
                setTimeout(function() {
                    if (alert.parentNode) {
                        alert.parentNode.removeChild(alert);
                    }
                }, 500);
            }, 5000);
        });
        
        // Автоматическое добавление returnTab во все формы
        document.querySelectorAll('form[data-return-tab]').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                var returnTab = this.dataset.returnTab;
                var existingInput = this.querySelector('input[name="returnTab"]');
                if (!existingInput) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'returnTab';
                    input.value = returnTab;
                    this.appendChild(input);
                } else {
                    existingInput.value = returnTab;
                }
            });
        });
        
        // ==========================================
        // ИНИЦИАЛИЗАЦИЯ DRAG-AND-DROP ДЛЯ ЗАПИСЕЙ В ШАБЛОНАХ
        // ==========================================
        function initSortableForItemsList(list) {
            if (!list || list.dataset.sortableInitialized) return;
            list.dataset.sortableInitialized = 'true';

            var parts = list.id.replace('items-list-', '').split('-');
            if (parts.length < 2) return;
            
            var type = parts[0];
            var templateId = parts[1];

            new Sortable(list, {
                animation: 150,
                handle: '.item-content',
                ghostClass: 'sortable-ghost',
                dragClass: 'sortable-drag',
                onEnd: function(evt) {
                    var items = list.querySelectorAll('.list-item');
                    var orderedIds = [];
                    items.forEach(function(item) {
                        var id = item.dataset.itemId;
                        if (id) orderedIds.push(id);
                    });

                    if (orderedIds.length < 2) return;

                    fetch('/Home/TemplateReorderItems', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            templateId: parseInt(templateId),
                            type: type,
                            orderedIds: orderedIds.join(',')
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showTempMessage('Порядок записей сохранён ✓', 'success');
                        } else {
                            showTempMessage('Ошибка: ' + (data.message || 'неизвестная'), 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Ошибка:', error);
                        
                    });
                }
            });
        }

        

        // Инициализация списков записей в шаблонах
        document.querySelectorAll('.items-list').forEach(function(list) {
            initSortableForItemsList(list);
        });

        // Инициализация контейнеров с шаблонами
        document.querySelectorAll('.templates-sortable-container').forEach(function(container) {
            initSortableForTemplates(container);
        });

        // Инициализация контейнеров форм создания
        document.querySelectorAll('#aboutItemsContainer, #resultItemsContainer, #engineItemsContainer, #priceItemsContainer, #graficItemsContainer, #additionalItemsContainer').forEach(function(container) {
            if (!container.dataset.sortableInitialized) {
                container.dataset.sortableInitialized = 'true';
                new Sortable(container, {
