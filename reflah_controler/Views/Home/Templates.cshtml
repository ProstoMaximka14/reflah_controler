    function getActiveTab() {
        var activeTab = document.querySelector('.nav-link.active');
        if (activeTab) {
            var target = activeTab.getAttribute('data-bs-target');
            if (target) {
                return target.replace('#tab-', '');
            }
        }
        return 'about';
    }
