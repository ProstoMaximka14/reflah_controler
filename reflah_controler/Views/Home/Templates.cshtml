                    <label class="form-label small">Описание RU</label>
                    <textarea class="form-control form-control-sm" name="items[{index}].GraficDescriptionRu" rows="2" placeholder="Описание на русском"></textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Описание EN</label>
                    <textarea class="form-control form-control-sm" name="items[{index}].GraficDescriptionEng" rows="2" placeholder="Description in English"></textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Описание DE</label>
                    <textarea class="form-control form-control-sm" name="items[{index}].GraficDescriptionGer" rows="2" placeholder="Beschreibung auf Deutsch"></textarea>
                </div>
                <div class="col-md-12">
                    <label class="form-label small">Изображение</label>
                    <input type="file" class="form-control form-control-sm" name="items[{index}].GraficImageFile" accept="image/*" />
                </div>
            </div>
        </div>
    </div>
</script>

