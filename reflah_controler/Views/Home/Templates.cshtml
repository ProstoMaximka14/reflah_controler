    // ==========================================
    // ДОБАВЛЕНИЕ ЗАПИСИ ПО ID (ДОБАВЛЕНИЕ)
    // ==========================================

    function addPriceById(templateId) {
        var input = document.getElementById('priceIdInput_' + templateId);
        var info = document.getElementById('priceInfo_' + templateId);
        var targetSelect = document.getElementById('targetSelect_' + templateId);
        var id = parseInt(input.value);
        
        if (!id || id <= 0) {
            info.innerHTML = '<span class="text-danger">❌ Введите корректный ID</span>';
            return;
        }
        
        var targetMap = {
            'free': 'freeTemplateSelect_' + templateId,
            'base': 'baseTemplateSelect_' + templateId,
            'pro': 'proTemplateSelect_' + templateId
        };
        
        var select = document.getElementById(targetMap[targetSelect.value]);
        
        if (!select) {
            info.innerHTML = '<span class="text-danger">❌ Селект не найден</span>';
            return;
        }
        
        // Проверяем, не выбран ли уже этот ID
        var alreadySelected = false;
        for (var i = 0; i < select.options.length; i++) {
            if (select.options[i].value === id.toString() && select.options[i].selected) {
                alreadySelected = true;
                break;
            }
        }
        
        if (alreadySelected) {
            info.innerHTML = '<span class="text-warning">⚠️ Запись #' + id + ' уже выбрана</span>';
            input.value = '';
            return;
        }
        
        // Находим опцию и выбираем её
        var found = false;
        for (var i = 0; i < select.options.length; i++) {
            if (select.options[i].value === id.toString()) {
                select.options[i].selected = true;
                found = true;
                break;
            }
        }
        
        if (found) {
            if (targetSelect.value === 'free') updateFreeTemplateList(templateId);
            else if (targetSelect.value === 'base') updateBaseTemplateList(templateId);
            else if (targetSelect.value === 'pro') updateProTemplateList(templateId);
            
            info.innerHTML = '<span class="text-success">✅ Запись #' + id + ' выбрана</span>';
            input.value = '';
        } else {
            info.innerHTML = '<span class="text-danger">❌ Запись #' + id + ' не найдена в списке</span>';
        }
    }

