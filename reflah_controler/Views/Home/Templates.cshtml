function showCarList(type, templateId, templateName) {
    var modal = document.getElementById('carListModal');
    var body = document.getElementById('carListModalBody');
    var title = document.getElementById('carListModalTitle');
    
    title.textContent = 'Машины, использующие шаблон "' + templateName + '"';
    body.innerHTML = `
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    `;
    
    modal.classList.add('show');
    
    // Загружаем список машин
    fetch('/Home/GetCarsUsingTemplate?type=' + type + '&templateId=' + templateId)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                renderCarList(data.cars);
            } else {
                body.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        Ошибка: ${data.message || 'неизвестная'}
                    </div>
                `;
            }
        })
        .catch(error => {
            console.error('Ошибка:', error);
            body.innerHTML = `
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                    Ошибка при загрузке списка машин
                </div>
            `;
        });
}

function renderCarList(cars) {
    var body = document.getElementById('carListModalBody');
    
    if (!cars || cars.length === 0) {
        body.innerHTML = `
            <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                <p>Шаблон не используется ни в одной машине</p>
            </div>
        `;
        return;
    }
    
    var html = `
        <div class="table-responsive">
            <table class="table table-sm table-hover table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Марка</th>
                        <th>Модель</th>
                        <th>Поколение</th>
                        <th>Действие</th>
                    </tr>
                </thead>
                <tbody>
    `;
    
    cars.forEach(function(car) {
        html += `
            <tr>
                <td>#${car.id}</td>
                <td>${car.brand || ''}</td>
                <td>${car.model || ''}</td>
                <td>${car.generation || ''}</td>
                <td>
                    <a href="/Home/EditCar/${car.id}" class="btn btn-sm btn-outline-primary" target="_blank">
                        <i class="bi bi-pencil"></i>
                    </a>
                </td>
            </tr>
        `;
    });
    
    html += `
                </tbody>
            </table>
        </div>
        <div class="text-muted small">Всего машин: <strong>${cars.length}</strong></div>
    `;
    
    body.innerHTML = html;
}

function closeCarListModal() {
    document.getElementById('carListModal').classList.remove('show');
}

// Закрытие по клику вне модального окна
document.addEventListener('click', function(e) {
    var modal = document.getElementById('carListModal');
    if (modal.classList.contains('show') && e.target === modal) {
        closeCarListModal();
    }
});

