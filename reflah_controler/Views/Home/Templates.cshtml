<script>
    // ============================================================
    // ПОЛНЫЙ JAVASCRIPT ДЛЯ УПРАВЛЕНИЯ ШАБЛОНАМИ
    // С ПОДДЕРЖКОЙ DRAG-AND-DROP (ЗАПИСИ + ШАБЛОНЫ)
    // ============================================================

    // ==========================================
    // ПЕРЕКЛЮЧЕНИЕ ШАБЛОНА
    // ==========================================
    function toggleTemplate(header) {
        var section = header.closest('.template-section');
        var content = section.querySelector('.template-content');
        var icon = header.querySelector('.toggle-icon');

        if (content) {
            content.classList.toggle('open');
            if (icon) {
                icon.classList.toggle('collapsed');
            }
        }
    }

    // ==========================================
    // ПЕРЕКЛЮЧЕНИЕ КАРТОЧКИ ЗАПИСИ
    // ==========================================
    function toggleItemCard(header) {
        var card = header.closest('.item-card');
        var body = card.querySelector('.item-body');
        if (body) {
            body.classList.toggle('open');
        }
    }

    // ==========================================
    // ПОКАЗАТЬ/СКРЫТЬ ФОРМУ СОЗДАНИЯ
    // ==========================================
    function showCreateForm(type) {
        var form = document.getElementById('createForm_' + type);
        if (form) {
            form.classList.remove('d-none');
            form.scrollIntoView({ behavior: 'smooth', block: 'center' });
            loadUnusedItems(type);
        }
    }

    function hideCreateForm(type) {
        var form = document.getElementById('createForm_' + type);
        if (form) {
            form.classList.add('d-none');
        }
    }

    // ==========================================
    // ЗАГРУЗКА НЕИСПОЛЬЗУЕМЫХ ЗАПИСЕЙ
    // ==========================================
    function loadUnusedItems(type) {
        fetch('/Home/GetUnusedItems?type=' + type)
            .then(response => response.json())
            .then(data => {
                var selects = document.querySelectorAll('#createForm_' + type + ' select[name$=".ExistingId"]');
                selects.forEach(function(select) {
                    var currentValue = select.value;
                    select.innerHTML = '<option value="">-- Выберите запись --</option>';
                    if (data && data.length > 0) {
                        data.forEach(function(item) {
                            var option = document.createElement('option');
                            option.value = item.id;
                            option.textContent = '# ' + item.id + ' - ' + (item.displayText || '(без названия)');
                            select.appendChild(option);
                        });
                    } else {
                        var option = document.createElement('option');
                        option.value = '';
                        option.textContent = 'Нет доступных записей';
                        option.disabled = true;
                        select.appendChild(option);
                    }
                    if (currentValue) {
                        select.value = currentValue;
                    }
                });
            })
            .catch(error => {
                console.error('Ошибка загрузки неиспользуемых записей:', error);
            });
    }

    // ==========================================
    // ЗАГРУЗКА НЕИСПОЛЬЗУЕМЫХ ЗАПИСЕЙ ДЛЯ КОНКРЕТНОГО SELECT
    // ==========================================
    function loadUnusedItemsForSelect(selectElement, type) {
        fetch('/Home/GetUnusedItems?type=' + type)
            .then(response => response.json())
            .then(data => {
                var currentValue = selectElement.value;
                selectElement.innerHTML = '<option value="">-- Выберите запись --</option>';
                if (data && data.length > 0) {
                    data.forEach(function(item) {
                        var option = document.createElement('option');
                        option.value = item.id;
                        option.textContent = '# ' + item.id + ' - ' + (item.displayText || '(без названия)');
                        selectElement.appendChild(option);
                    });
                } else {
                    var option = document.createElement('option');
                    option.value = '';
                    option.textContent = 'Нет доступных записей';
                    option.disabled = true;
                    selectElement.appendChild(option);
                }
                if (currentValue) {
                    selectElement.value = currentValue;
                }
            })
            .catch(error => {
                console.error('Ошибка загрузки неиспользуемых записей:', error);
            });
    }

    // ==========================================
    // ПОКАЗАТЬ/СКРЫТЬ ФОРМУ ДОБАВЛЕНИЯ ЗАПИСИ В ШАБЛОН
    // ==========================================
    function showAddItemForm(type, templateId) {
        var form = document.getElementById('addItemForm-' + type + '-' + templateId);
        if (form) {
            form.classList.remove('d-none');
            loadUnusedItemsForTemplate(type, templateId);
        }
    }

    function hideAddItemForm(type, templateId) {
        var form = document.getElementById('addItemForm-' + type + '-' + templateId);
        if (form) {
            form.classList.add('d-none');
        }
    }

    function loadUnusedItemsForTemplate(type, templateId) {
        fetch('/Home/GetUnusedItems?type=' + type)
            .then(response => response.json())
            .then(data => {
                var select = document.getElementById('unusedItems-' + type + '-' + templateId);
                if (select) {
                    select.innerHTML = '<option value="">-- Выберите запись --</option>';
                    if (data && data.length > 0) {
                        data.forEach(function(item) {
                            var option = document.createElement('option');
                            option.value = item.id;
                            option.textContent = '# ' + item.id + ' - ' + (item.displayText || '(без названия)');
                            select.appendChild(option);
                        });
                    } else {
                        var option = document.createElement('option');
                        option.value = '';
                        option.textContent = 'Нет доступных записей';
                        option.disabled = true;
                        select.appendChild(option);
                    }
                }
            })
            .catch(error => {
                console.error('Ошибка загрузки неиспользуемых записей:', error);
            });
    }

    // ==========================================
    // ДОБАВЛЕНИЕ СУЩЕСТВУЮЩЕГО ШАБЛОНА В ФОРМУ
    // ==========================================
    function addExistingTemplateToForm(type, containerId) {
        var select = document.getElementById('existingTemplateSelect_' + type);
        var templateId = select.value;

        if (!templateId) {
            alert('Выберите шаблон');
            return;
        }

        var templateName = select.options[select.selectedIndex].text;
        var container = document.getElementById(containerId);

        var templateCard = document.createElement('div');
        templateCard.className = 'item-card template-card mb-2';

        var index = container.querySelectorAll('.item-card').length;

        templateCard.innerHTML = `
            <div class="item-header" onclick="toggleItemCard(this)">
                <span>
                    <span class="badge bg-primary">шаблон ID: ${templateId}</span>
                    <strong>${templateName}</strong>
                </span>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.item-card').remove(); updateItemNumbers(this.closest('.items-container'));">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
            <div class="item-body open">
                <div class="row g-2">
                    <div class="col-md-12">
                        <input type="hidden" name="items[${index}].TemplateId" value="${templateId}" />
                        <div class="alert alert-info small mb-0">
                            <i class="bi bi-collection"></i>
                            Шаблон будет добавлен как вложенный
                        </div>
                    </div>
                </div>
            </div>
        `;

        container.appendChild(templateCard);
        updateItemNumbers(container);
        select.value = '';
    }

    // ==========================================
    // ДОБАВЛЕНИЕ ЗАПИСИ В ФОРМУ
    // ==========================================
    var itemCounters = {
        about: 1,
        result: 1,
        engine: 1,
        price: 1,
        grafic: 1,
        additional: 1
    };

    function addItem(type, containerId, templateId) {
        var container = document.getElementById(containerId);
        if (!container) return;

        itemCounters[type] = (itemCounters[type] || 1) + 1;
        var index = itemCounters[type] - 1;

        var template = document.getElementById(templateId);
        if (!template) return;

        var html = template.innerHTML
            .replace(/\{index\}/g, index)
            .replace(/\{type\}/g, type);

        var div = document.createElement('div');
        div.innerHTML = html;
        var newItem = div.firstElementChild;
        if (newItem) {
            container.appendChild(newItem);
            updateItemNumbers(container);

            var newSelect = newItem.querySelector('select[name$=".ExistingId"]');
            if (newSelect) {
                loadUnusedItemsForSelect(newSelect, type);
            }
        }
    }

    function removeItem(button, type) {
        var card = button.closest('.item-card');
        var container = card.parentElement;
        if (container.children.length > 1) {
            card.remove();
            updateItemNumbers(container);
        } else {
            alert('Должна быть хотя бы одна запись');
        }
    }

    function updateItemNumbers(container) {
        var items = container.querySelectorAll('.item-card');
        items.forEach(function(item, index) {
            var label = item.querySelector('.item-header strong');
            if (label) {
                label.textContent = 'Запись #' + (index + 1);
            }
            var inputs = item.querySelectorAll('input, textarea, select');
            inputs.forEach(function(input) {
                var name = input.getAttribute('name');
                if (name) {
                    var newName = name.replace(/items\[\d+\]/, 'items[' + index + ']');
                    input.setAttribute('name', newName);
                }
            });
        });
    }

    // ==========================================
    // ПОКАЗАТЬ ВСЕ ЗАПИСИ
    // ==========================================
    function showAllItems(type) {
        var container = document.getElementById('allItemsContainer-' + type);
        if (!container) return;
        container.classList.remove('d-none');
        container.scrollIntoView({ behavior: 'smooth', block: 'center' });
        loadAllItems(type);
    }

    function hideAllItems(type) {
        var container = document.getElementById('allItemsContainer-' + type);
        if (container) {
            container.classList.add('d-none');
        }
    }

    function loadAllItems(type) {
        var listContainer = document.getElementById('allItemsList-' + type);
        if (!listContainer) return;

        listContainer.innerHTML = `
            <div class="text-center py-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>
        `;

        fetch('/Home/GetItemsByType?type=' + type)
            .then(response => response.json())
            .then(data => {
                var countBadge = document.getElementById('allItemsCount-' + type);
                if (countBadge) {
                    countBadge.textContent = data.length + ' записей';
                }

                if (data && data.length > 0) {
                    var html = '<div class="table-responsive"><table class="table table-sm table-hover table-striped">';
                    html += '<thead><tr><th>ID</th><th>Содержание</th><th class="text-center">Действия</th></tr></thead><tbody>';
                    data.forEach(function(item) {
                        var displayText = getDisplayText(type, item);
                        html += `<tr>
                            <td>#${item.id}</td>
                            <td>${displayText}</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="editItem('${type}', ${item.id})" title="Редактировать">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('${type}', ${item.id})" title="Удалить">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>`;
                    });
                    html += '</tbody></table></div>';
                    html += '<div class="text-muted small">Всего записей: <strong>' + data.length + '</strong></div>';
                    listContainer.innerHTML = html;
                } else {
                    listContainer.innerHTML = '<div class="text-center py-3 text-muted"><i class="bi bi-inbox"></i> Нет записей</div>';
                }
            })
            .catch(error => {
                console.error('Ошибка загрузки:', error);
                listContainer.innerHTML = '<div class="text-center py-3 text-danger"><i class="bi bi-exclamation-triangle"></i> Ошибка загрузки</div>';
            });
    }

    function getDisplayText(type, item) {
        switch (type) {
            case 'about':
            case 'result':
            case 'engine':
                return item.textRu || item.textEng || item.textGer || '(пусто)';
            case 'price':
                return item.nameRu || item.nameEng || item.nameGer || '(без названия)';
            case 'grafic':
                return item.name || '(без названия)';
            case 'additional':
                return item.nameRu || item.nameEng || item.nameGer || '(без названия)';
            default:
                return JSON.stringify(item);
        }
    }

    // ==========================================
    // РЕДАКТИРОВАНИЕ ЗАПИСИ
    // ==========================================
    var currentEditType = null;
    var currentEditId = null;

    function editItem(type, id) {
        currentEditType = type;
        currentEditId = id;

        var modal = document.getElementById('editModal');
        var body = document.getElementById('editModalBody');
        var title = document.getElementById('editModalTitle');

        title.textContent = 'Редактирование записи #' + id + ' (' + getTypeLabel(type) + ')';
        body.innerHTML = `
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>
        `;

        modal.classList.add('show');

        fetch('/Home/GetItemById?type=' + type + '&id=' + id)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    renderEditForm(type, data.item);
                } else {
                    body.innerHTML = `
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i>
                            Ошибка загрузки: ${data.message || 'неизвестная'}
                        </div>
                        <button class="btn btn-secondary" onclick="closeEditModal()">Закрыть</button>
                    `;
                }
            })
            .catch(error => {
                console.error('Ошибка:', error);
                body.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        Ошибка при загрузке данных
                    </div>
                    <button class="btn btn-secondary" onclick="closeEditModal()">Закрыть</button>
                `;
            });
    }

    function renderEditForm(type, item) {
        var body = document.getElementById('editModalBody');
        var html = '';

        switch (type) {
            case 'about':
            case 'result':
            case 'engine':
                html = `
                    <form id="editForm" onsubmit="saveEditItem(event)">
                        <input type="hidden" name="type" value="${type}" />
                        <input type="hidden" name="id" value="${item.id}" />
                        <div class="form-group">
