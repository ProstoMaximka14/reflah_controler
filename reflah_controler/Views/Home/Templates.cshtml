// ПОИСК ВНУТРИ ВКЛАДКИ (about, result, engine, price, additional, grafic)
// ==========================================

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.tab-search-input').forEach(function(input) {
        const tab = input.dataset.tab;
        const clearBtn = document.querySelector(`.tab-clear-btn[data-tab="${tab}"]`);
        
        input.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            
            if (query.length === 0) {
                if (clearBtn) clearBtn.style.display = 'none';
                showAllTemplatesInTab(tab);
                return;
            }
            
            if (clearBtn) clearBtn.style.display = 'block';
            filterTemplatesInTab(tab, query);
        });
        
        if (clearBtn) {
            clearBtn.addEventListener('click', function() {
                input.value = '';
                this.style.display = 'none';
                showAllTemplatesInTab(tab);
                input.focus();
            });
        }
    });
});

function filterTemplatesInTab(tab, query) {
    const container = document.querySelector(`#tab-${tab} .templates-sortable-container`);
    if (!container) return;
    
    const sections = container.querySelectorAll('.template-section');
    let found = false;
    
    sections.forEach(function(section) {
        const nameElement = section.querySelector('.card-header strong');
        if (nameElement) {
            const name = nameElement.textContent.toLowerCase();
            if (name.includes(query)) {
                section.style.display = '';
                found = true;
            } else {
                section.style.display = 'none';
            }
        }
    });
    
    let emptyMsg = container.querySelector('.tab-empty-message');
    if (!found) {
        if (!emptyMsg) {
            emptyMsg = document.createElement('div');
            emptyMsg.className = 'tab-empty-message text-center py-4 text-muted';
            emptyMsg.innerHTML = `
                <i class="bi bi-search fs-3 d-block mb-2"></i>
                <p>Шаблоны по запросу "<strong>${query}</strong>" не найдены</p>
            `;
            container.appendChild(emptyMsg);
        }
        emptyMsg.style.display = '';
    } else {
        if (emptyMsg) {
            emptyMsg.style.display = 'none';
        }
    }
}

function showAllTemplatesInTab(tab) {
    const container = document.querySelector(`#tab-${tab} .templates-sortable-container`);
    if (!container) return;
    
    container.querySelectorAll('.template-section').forEach(function(section) {
        section.style.display = '';
    });
    
    const emptyMsg = container.querySelector('.tab-empty-message');
    if (emptyMsg) {
        emptyMsg.style.display = 'none';
    }
}
    
</script>
