    function toggleAddPriceControlerFields(templateId) {
        var select = document.getElementById('addPriceControler_' + templateId);
        var extendedFields = document.getElementById('addExtendedPriceFields_' + templateId);
        var unselectedContainer = document.getElementById('addUnselectedModeContainer_' + templateId);
        
        if (select && extendedFields) {
            if (select.value === '2') {
                extendedFields.style.display = '';
                if (unselectedContainer) {
                    unselectedContainer.style.display = '';
                }
            } else {
                extendedFields.style.display = 'none';
                if (unselectedContainer) {
                    unselectedContainer.style.display = 'none';
                    var unselectedSelect = unselectedContainer.querySelector('select');
                    if (unselectedSelect) {
                        unselectedSelect.value = '0';
                    }
                }
            }
        }
    }

