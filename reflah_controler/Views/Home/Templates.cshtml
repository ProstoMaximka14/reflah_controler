    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('form[action*="UpdateTemplateItem"]').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                var hiddenFields = this.querySelectorAll('input[type="hidden"][name$="PriceIds"]');
                hiddenFields.forEach(function(hidden) {
                    if (hidden.value) {
                        var ids = hidden.value.split(',');
                        var uniqueIds = [];
                        var seen = new Set();
                        for (var i = 0; i < ids.length; i++) {
                            var id = ids[i].trim();
                            if (id && !seen.has(id)) {
                                seen.add(id);
                                uniqueIds.push(id);
                            }
                        }
                        hidden.value = uniqueIds.join(',');
                    }
                });
            });
        });
    });

