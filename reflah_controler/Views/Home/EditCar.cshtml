    // ==========================================
    function saveTextRecord(event, form, block) {
        event.preventDefault();
        
        var btn = form.querySelector('button[type="submit"]');
        var originalText = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Сохранение...';
        btn.disabled = true;
        
        var formData = new FormData(form);
        
        fetch(form.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                var itemCard = form.closest('.list-item');
                if (itemCard) {
                    var preview = itemCard.querySelector('.item-preview-text');
                    if (preview) {
                        var textRu = form.querySelector('textarea[name="textRu"]')?.value || '';
                        var textEng = form.querySelector('textarea[name="textEng"]')?.value || '';
                        var textGer = form.querySelector('textarea[name="textGer"]')?.value || '';
                        var newText = textRu || textEng || textGer || '(пусто)';
                        if (newText.length > 60) newText = newText.substring(0, 60) + '...';
                        preview.textContent = newText;
                    }
                }
                var detail = form.closest('.item-detail');
                if (detail) detail.style.display = 'none';
                var btn = detail?.previousElementSibling?.querySelector('.btn-outline-primary');
                if (btn) btn.innerHTML = '<i class="bi bi-pencil"></i>';
                showTempMessage('Запись сохранена', 'success');
            } else {
                showTempMessage('Ошибка: ' + (data.message || ''), 'error');
            }
        })
        .catch(error => {
            console.error('Ошибка:', error);
            showTempMessage('Ошибка при сохранении', 'error');
        })
        .finally(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
        });
        
        return false;
    }

