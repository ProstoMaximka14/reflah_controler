                    }
                }
            }
        }
    }

    // ==========================================
    // ПЕРЕМЕЩЕНИЕ ЗАПИСИ В БЛОКЕ АВТОМОБИЛЯ
    // ==========================================
    function moveItem(carId, blockName, itemId, direction) {
        showTempMessage('Перемещение...', 'info');
        
        fetch('/Home/EditCarMoveItem', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                carId: carId,
                block: blockName,
                itemId: itemId,
                direction: direction
            })
        })
        .then(function(response) {
            if (!response.ok) {
                throw new Error('Ошибка сервера: ' + response.status);
            }
            return response.json();
        })
        .then(function(data) {
            if (data.success) {
                showTempMessage('Запись перемещена ✓', 'success');
                location.reload();
            } else {
                showTempMessage('Ошибка: ' + (data.message || 'неизвестная'), 'error');
            }
        })
        .catch(function(error) {
            console.error('Ошибка:', error);
            showTempMessage('Ошибка: ' + error.message, 'error');
        });
    }

