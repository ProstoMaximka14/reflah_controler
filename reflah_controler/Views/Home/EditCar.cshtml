                WriteLiteral($"<input type=\"hidden\" name=\"block\" value=\"{block}\" />");
                WriteLiteral($"<input type=\"hidden\" name=\"templateId\" value=\"{t.Id}\" />");
                WriteLiteral("<button type=\"submit\" class=\"btn btn-sm btn-primary\">Выбрать</button></form>");
            }
            WriteLiteral("</div>");
        }

        WriteLiteral("</div></div></div></div>");
    }
