    // ==========================================
    // ИНИЦИАЛИЗАЦИЯ ПРИ ЗАГРУЗКЕ
    // ==========================================
    document.addEventListener('DOMContentLoaded', function() {
        // Состояние блоков
        document.querySelectorAll('.block-card').forEach(card => {
            const id = card.id;
            if (id) {
                const isOpen = localStorage.getItem('block_' + id);
                const body = card.querySelector('.block-body');
                const icon = card.querySelector('.toggle-icon');
                
                if (isOpen === 'false') {
                    if (body) body.classList.remove('show');
                    if (icon) icon.classList.add('collapsed');
                } else if (isOpen === 'true') {
                    if (body) body.classList.add('show');
                    if (icon) icon.classList.remove('collapsed');
                }
            }
        });
        
        document.querySelectorAll('.block-header').forEach(header => {
            header.addEventListener('click', function() {
                const section = this.closest('.block-card');
                if (section && section.id) {
                    const body = section.querySelector('.block-body');
                    const isOpen = body && body.classList.contains('show');
                    localStorage.setItem('block_' + section.id, isOpen ? 'true' : 'false');
                }
            });
        });

        // Авто-скрытие сообщений
        const messages = document.querySelectorAll('.message-box');
        messages.forEach(message => {
            setTimeout(() => {
                message.style.opacity = '0';
                message.style.transition = 'opacity 0.5s ease';
                setTimeout(() => {
                    if (message.parentNode) {
                        message.parentNode.removeChild(message);
                    }
                }, 500);
            }, 5000);
        });
    });
