@model reflah_controler.Models.ReflashCarModel
@{
    ViewData["Title"] = $"Редактирование: {Model.Brand} {Model.Model}";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        .car-input, .car-textarea, .car-select {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            box-sizing: border-box;
            font-size: 14px;
            font-family: inherit;
        }

        .car-input:focus, .car-textarea:focus, .car-select:focus {
            border-color: #86b7fe;
            outline: 0;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .car-textarea {
            min-height: 120px;
            resize: vertical;
        }

        .message-box {
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        .message-success {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }

        .message-error {
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
        }

        .car-image-preview {
            max-height: 300px;
            object-fit: contain;
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 10px;
        }

        .placeholder-image {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 200px;
            background-color: #f8f9fa;
            border-radius: 8px;
            color: #6c757d;
        }

        .tab-content {
            border: 1px solid #dee2e6;
            border-top: none;
            padding: 20px;
            border-radius: 0 0 4px 4px;
            background-color: #fff;
        }

        .nav-tabs .nav-link.active {
            background-color: #fff;
            border-color: #dee2e6 #dee2e6 #fff;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <!-- Сообщения -->
        @if (TempData["Message"] != null)
        {
            <div class="message-box message-success">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Message"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="message-box message-error">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                @TempData["Error"]
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-0">
                    <i class="bi bi-car-front-fill text-primary"></i>
                    @Model.Brand @Model.Model
                    @if (!string.IsNullOrEmpty(Model.Generation))
                    {
                        <span class="text-muted h4">(@Model.Generation)</span>
                    }
                </h1>
                <div class="text-muted">ID: #@Model.Id</div>
            </div>
            <div>
                <a href="@Url.Action("Cars")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Назад к списку
                </a>
            </div>
        </div>

        <form method="post" action="/Home/UpdateCar">
            <input type="hidden" name="Id" value="@Model.Id">
            
            <!-- Блок с изображением -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-image text-primary"></i> Изображение автомобиля</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <img src="@Model.Image" class="img-fluid car-image-preview mb-3" 
                                     alt="@Model.Brand @Model.Model"
                                     onerror="this.style.display='none'; document.getElementById('noImageMessage').style.display='block';">
                            }
                            <div id="noImageMessage" class="@(string.IsNullOrEmpty(Model.Image) ? "" : "d-none")">
                                <div class="placeholder-image">
                                    <i class="bi bi-car-front fs-1"></i>
                                    <div class="mt-2">Изображение отсутствует</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ссылка на изображение</label>
                                <input type="text" class="form-control" name="Image" value="@Model.Image" 
                                       placeholder="https://example.com/image.jpg">
                                <div class="form-text">Введите URL изображения для предварительного просмотра</div>
                            </div>
                            <button type="button" class="btn btn-outline-primary" onclick="previewImage()">
                                <i class="bi bi-eye"></i>
                                Предварительный просмотр
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Основная информация -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle text-primary"></i> Основная информация</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Марка*</label>
                            <input type="text" class="form-control" name="Brand" value="@Model.Brand" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Модель*</label>
                            <input type="text" class="form-control" name="Model" value="@Model.Model" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Поколение</label>
                            <input type="text" class="form-control" name="Generation" value="@Model.Generation">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Двигатель</label>
                            <input type="text" class="form-control" name="Engine" value="@Model.Engine">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Текстовые поля с вкладками -->
            <div class="card mb-4">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" id="carTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="ru-tab" data-bs-toggle="tab" data-bs-target="#ru" type="button">
                                <i class="bi bi-flag-fill text-danger"></i> Русский
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="eng-tab" data-bs-toggle="tab" data-bs-target="#eng" type="button">
                                <i class="bi bi-flag-fill text-primary"></i> Английский
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="ger-tab" data-bs-toggle="tab" data-bs-target="#ger" type="button">
                                <i class="bi bi-flag-fill text-warning"></i> Немецкий
                            </button>
                        </li>
                    </ul>
                </div>
                
                <div class="tab-content" id="carTabsContent">
                    <!-- Русский язык -->
                    <div class="tab-pane fade show active" id="ru" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Описание</label>
                                <textarea class="form-control car-textarea" name="AboutRu" rows="4">@Model.AboutRu</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Результат тюнинга</label>
                                <textarea class="form-control car-textarea" name="ResultRu" rows="4">@Model.ResultRu</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Блок управления</label>
                                <textarea class="form-control car-textarea" name="EngineControlRu" rows="4">@Model.EngineControlRu</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Опции</label>
                                <textarea class="form-control car-textarea" name="OptionsRu" rows="4">@Model.OptionsRu</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Цена</label>
                                <textarea class="form-control car-textarea" name="PriceRu" rows="4">@Model.PriceRu</textarea>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Английский язык -->
                    <div class="tab-pane fade" id="eng" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea class="form-control car-textarea" name="AboutEng" rows="4">@Model.AboutEng</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Tuning Result</label>
                                <textarea class="form-control car-textarea" name="ResultEng" rows="4">@Model.ResultEng</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Engine Control Unit</label>
                                <textarea class="form-control car-textarea" name="EngineControlEng" rows="4">@Model.EngineControlEng</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Options</label>
                                <textarea class="form-control car-textarea" name="OptionsEng" rows="4">@Model.OptionsEng</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Price</label>
                                <textarea class="form-control car-textarea" name="PriceEng" rows="4">@Model.PriceEng</textarea>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Немецкий язык -->
                    <div class="tab-pane fade" id="ger" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Beschreibung</label>
                                <textarea class="form-control car-textarea" name="AboutGer" rows="4">@Model.AboutGer</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Tuning-Ergebnis</label>
                                <textarea class="form-control car-textarea" name="ResultGer" rows="4">@Model.ResultGer</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Motorsteuergerät</label>
                                <textarea class="form-control car-textarea" name="EngineControlGer" rows="4">@Model.EngineControlGer</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Optionen</label>
                                <textarea class="form-control car-textarea" name="OptionsGer" rows="4">@Model.OptionsGer</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Preis</label>
                                <textarea class="form-control car-textarea" name="PriceGer" rows="4">@Model.PriceGer</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Кнопки действий -->
            <div class="d-flex justify-content-between">
                <div>
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-check-circle"></i>
                        Сохранить изменения
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="window.location.reload()">
                        <i class="bi bi-arrow-clockwise"></i>
                        Отмена
                    </button>
                </div>
                
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="bi bi-trash"></i>
                    Удалить автомобиль
                </button>
            </div>
        </form>
    </div>

    <!-- Модальное окно подтверждения удаления -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Подтверждение удаления
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Вы уверены, что хотите удалить автомобиль <strong>@Model.Brand @Model.Model</strong>?</p>
                    <p class="text-danger"><small>Это действие нельзя отменить!</small></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <form method="post" action="/Home/DeleteCar" style="display: inline;">
                        <input type="hidden" name="id" value="@Model.Id">
                        <button type="submit" class="btn btn-danger">Удалить</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Автоматически скрываем сообщения через 5 секунд
        document.addEventListener('DOMContentLoaded', function() {
            const messages = document.querySelectorAll('.message-box');
            messages.forEach(message => {
                setTimeout(() => {
                    message.style.opacity = '0';
                    message.style.transition = 'opacity 0.5s ease';
                    setTimeout(() => {
                        if (message.parentNode) {
                            message.parentNode.removeChild(message);
                        }
                    }, 500);
                }, 5000);
            });

            // Инициализация табов
            const triggerTabList = [].slice.call(document.querySelectorAll('#carTabs button'));
            triggerTabList.forEach(function (triggerEl) {
                const tabTrigger = new bootstrap.Tab(triggerEl);
                triggerEl.addEventListener('click', function (event) {
                    event.preventDefault();
                    tabTrigger.show();
                });
            });
        });

        // Функция предварительного просмотра изображения
        function previewImage() {
            const imageUrl = document.querySelector('input[name="Image"]').value;
            if (imageUrl) {
                const img = document.querySelector('.car-image-preview');
                const noImageMessage = document.getElementById('noImageMessage');
                
                if (img) {
                    img.src = imageUrl;
                    img.style.display = 'block';
                    noImageMessage.style.display = 'none';
                } else {
                    // Если изображение отсутствует, создаем его
                    const imageContainer = document.querySelector('.col-md-6');
                    const newImg = document.createElement('img');
                    newImg.src = imageUrl;
                    newImg.className = 'img-fluid car-image-preview mb-3';
                    newImg.alt = 'Предварительный просмотр';
                    newImg.onerror = function() {
                        this.style.display = 'none';
                        noImageMessage.style.display = 'block';
                    };
                    
                    const existingImg = imageContainer.querySelector('img');
                    if (existingImg) {
                        existingImg.replaceWith(newImg);
                    } else {
                        imageContainer.insertBefore(newImg, imageContainer.firstChild);
                        noImageMessage.style.display = 'none';
                    }
                }
            }
        }
    </script>
</body>
</html>
