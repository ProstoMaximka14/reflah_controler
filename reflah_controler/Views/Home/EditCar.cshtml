                WriteLiteral($"<small class=\"text-muted\">ID #{t.Id} · записи: {System.Net.WebUtility.HtmlEncode(string.IsNullOrEmpty(t.IdsPreview) ? "—" : t.IdsPreview)}</small>");
                WriteLiteral("</div>");
