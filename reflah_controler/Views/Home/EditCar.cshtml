        {
            WriteLiteral("<div class=\"list-group\">");
            foreach (var t in templates)
            {
                WriteLiteral($"<form method=\"post\" action=\"{Url.Action("EditCarAttachTemplate")}\" class=\"list-group-item list-group-item-action d-flex justify-content-between align-items-center\">");
                WriteLiteral("<div>");
