@section Scripts {
<script>
    // ==========================================
    // ПЕРЕКЛЮЧЕНИЕ ВИДИМОСТИ БЛОКА
    // ==========================================
    function toggleBlock(headerElement) {
        const block = headerElement.closest('.block-card');
        const body = block.querySelector('.block-body');
        const icon = headerElement.querySelector('.toggle-icon');
        
        if (body) {
            body.classList.toggle('show');
            if (icon) {
                icon.classList.toggle('collapsed');
            }
        }
    }

    // ==========================================
    // ПЕРЕКЛЮЧЕНИЕ ДЕТАЛЕЙ ЗАПИСИ
    // ==========================================
    function toggleItemDetail(btn) {
        var parent = btn.closest('.list-item');
        if (!parent) return;
        var detail = parent.nextElementSibling;
        while (detail && !detail.classList.contains('item-detail')) {
            detail = detail.nextElementSibling;
        }
        if (detail) {
            if (detail.style.display === 'none' || detail.style.display === '') {
                detail.style.display = 'block';
                btn.innerHTML = '<i class="bi bi-chevron-up"></i>';
            } else {
                detail.style.display = 'none';
                btn.innerHTML = '<i class="bi bi-pencil"></i>';
            }
        }
    }

    // ==========================================
    // ПЕРЕКЛЮЧЕНИЕ ПАНЕЛИ ДОБАВЛЕНИЯ
    // ==========================================
    function togglePanel(id) {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('show');
    }

    // ==========================================
