    // ==========================================
    // ПЕРЕКЛЮЧЕНИЕ ПОЛЕЙ ДЛЯ PRICE_CONTROLER == 2
    // ==========================================
    function togglePriceControlerFields(id) {
        var select = document.getElementById('priceControler_' + id);
        var extendedFields = document.getElementById('extendedPriceFields_' + id);
        var unselectedContainer = document.getElementById('unselectedModeContainer_' + id);
        
        if (select && extendedFields) {
            if (select.value === '2') {
                extendedFields.style.display = '';
                if (unselectedContainer) {
                    unselectedContainer.style.display = '';
                }
            } else {
                extendedFields.style.display = 'none';
                if (unselectedContainer) {
                    unselectedContainer.style.display = 'none';
                    // Сбрасываем значение на 0, когда поле скрыто
                    var unselectedSelect = unselectedContainer.querySelector('select');
                    if (unselectedSelect) {
                        unselectedSelect.value = '0';
                    }
                }
            }
        }
    }

    function toggleAddPriceControlerFields() {
        var select = document.getElementById('addPriceControler');
        var extendedFields = document.getElementById('addExtendedPriceFields');
        var unselectedContainer = document.getElementById('addUnselectedModeContainer');
        
        if (select && extendedFields) {
            if (select.value === '2') {
                extendedFields.style.display = '';
                if (unselectedContainer) {
                    unselectedContainer.style.display = '';
                }
            } else {
                extendedFields.style.display = 'none';
                if (unselectedContainer) {
                    unselectedContainer.style.display = 'none';
                    // Сбрасываем значение на 0
                    var unselectedSelect = unselectedContainer.querySelector('select');
